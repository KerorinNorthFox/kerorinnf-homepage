---
import DateText from "@/components/DateText.astro";

interface Props {
  title: string;
  description: string;
  publishedDate?: string | Date | undefined;
  updatedDate?: string | Date | undefined;
  tags: string[] | undefined;
  headingImage: string | undefined
}

const { title, description, publishedDate, updatedDate, tags, headingImage} = Astro.props;
---
<div class="min-h-screen mx-auto px-8 py-12 sm:px-20 shadow-xl">
  <article>
    {
      publishedDate && (
        <div class="text-end">
          <DateText publishedDate={publishedDate} updatedDate={updatedDate} />
        </div>
      )
    }
    <h1 class="my-4 text-2xl font-bold">{title}</h1>
    {
      tags && (
        <div class="flex space-x-2 m-2">
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M856-390 570-104q-12 12-27 18t-30 6q-15 0-30-6t-27-18L103-457q-11-11-17-25.5T80-513v-287q0-33 23.5-56.5T160-880h287q16 0 31 6.5t26 17.5l352 353q12 12 17.5 27t5.5 30q0 15-5.5 29.5T856-390ZM513-160l286-286-353-354H160v286l353 354ZM260-640q25 0 42.5-17.5T320-700q0-25-17.5-42.5T260-760q-25 0-42.5 17.5T200-700q0 25 17.5 42.5T260-640Zm220 160Z"/></svg>
          {
            tags.map((tag) => (
              <a href={`/blog/tags/${tag}`} class="text-xs font-medium me-2 px-3 py-1 rounded bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300 hover:bg-blue-300 dark:hover:bg-blue-700">{tag}</a>
            ))
          }
        </div>
      )
    }
    <div>
      {
        headingImage && (
          <img src={headingImage} alt="" class="shadow-[0px_10px_30px_rgba(0,0,0,0.50)]" />
        )
      }
    </div>
    <hr class="my-12" />
    <div class="xl:hidden max-w-2xl m-4">
      <slot name="toc" />
    </div>
    <div class="relative flex justify-between">
      <div class="prose dark:prose-invert sm:prose-lg lg:prose-xl">
        <slot />
      </div>
      <aside class="hidden xl:block max-w-64">
        <slot name="toc" />
      </aside>
    </div>
  </article>
</div>