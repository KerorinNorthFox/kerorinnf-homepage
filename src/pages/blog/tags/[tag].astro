---
import PostHeadingTile from "@/components/PostHeadingTile.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResponsiveWidth from "@/layouts/ResponsiveWidth.astro";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");

  const tags = posts.flatMap((post) => post.data.tags ?? []); // flatMapで1次元で配列を展開
  const uniqueTags = Array.from(new Set(tags)); // Set型で重複を削除

  return uniqueTags.map((tag) => ({
    params: { tag },
  }))
}) satisfies GetStaticPaths;

const { tag } = Astro.params;

const posts = (await getCollection("blog")).filter((post) => post.data.tags?.includes(tag));
---
<BaseLayout title=`${tag}の投稿一覧` description=`ブログのタグ「${tag}}」の投稿一覧`>
  <ResponsiveWidth>
    <div class="p-8 min-h-[calc(100vh-4rem)]">
      <p class="text-xl font-bold">
        <span>{posts.length}個の記事が見つかりました。</span>
        <span>タグ名：{tag}</span>
      </p>
      <section class="mt-4">
        <ul class="flex flex-wrap gap-8 justify-center">
          {
            posts.map((post) => (
              <li>
                <PostHeadingTile category="blog" post={post} />
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </ResponsiveWidth>
</BaseLayout>