---
import IntroductionCard from "@/components/IntroductionCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "@/libs/consts";

const keywords = ["KerorinNF", "kerorinnf", "KerorinNorthFox", "blog", "けろりん", "けろりん北狐"];
---

<BaseLayout title="ホームページ" description={SITE_DESCRIPTION} keywords={keywords}>
	<div class="h-[150vh] lg:h-[calc(100vh-4rem)]">
		<div class="flex flex-col lg:flex-row lg:justify-evenly items-center h-full px-8 lg:px-0">
			<div class="flex flex-1 flex-col justify-center max-w-md gap-8 text-center">
				<h1 class="text-4xl font-extrabold">けろりん北狐のホームページ</h1>
				<p class="text-lg">ケモ耳が大好き</p>
				<div>
					<img class="mx-auto" src="https://count.getloli.com/get/@kerorinnf?theme=gelbooru&darkmode=0" alt="aceess counter" />
					<p class="text-xs text-gray-500">↑ケモ耳可愛い</p>
				</div>
			</div>
			<div class="flex-1 max-w-lg w-full">
				<h1 class="text-3xl text-center mb-4">管理者</h1>
				<IntroductionCard />
			</div>
		</div>
	</div>
</BaseLayout>
