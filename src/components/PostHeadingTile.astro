---
import type { CollectionEntry } from 'astro:content'
import DateText from './DateText.astro';

interface Props {
  post: CollectionEntry<"blog">;
  category: string;
}

const { post, category } = Astro.props;
---
<div class="max-w-sm border rounded-lg border-gray-300 dark:border-gray-500 bg-white/10 shadow-md hover:shadow-lg hover:-translate-y-1">
    <a href={`/${category}/${post.id}`}>
      {
        post.data.headingImage ? (
          <img class="rounded-t-lg object-cover" src={post.data.headingImage} />
        ) : (
          <div class="h-64"></div>
        )
      }
    </a>
    <div class="pt-2 pb-4 px-8 overflow-hidden">
      <p class="text-right"><DateText publishedDate={post.data.publishedDate} updatedDate={post.data.updatedDate} /></p>
      <p class="text-wrap text-lg font-bold">{post.data.title}</p>
      <p class="truncate mt-2 text-sm text-gray-600 dark:text-gray-300">{post.data.description}</p>
    </div>
</div>