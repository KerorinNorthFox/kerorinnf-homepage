<div class="rounded-lg bg-white/60 border border-gray-200 dark:border-white/30 w-full p-8 shadow-xl text-gray-900">
  <div class="flex overflow-x-auto">
    <img src={icon.src} class="w-28 h-28 rounded-full bg-gray-200" alt="profile icon" />
